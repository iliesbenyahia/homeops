{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Charts OCI dans apps/upstream/*/config.yaml",
      "managerFilePatterns": ["/^apps/upstream/.*/config\\.yaml$/"],
      "matchStrings": [
        "repoURL:\\s*oci://(?<registry>\\S+)\\s+name:\\s*(?<chart>\\S+)\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "{{{registry}}}/{{{chart}}}",
      "depNameTemplate": "{{{chart}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Dépôts Helm classiques dans apps/upstream/*/config.yaml",
      "managerFilePatterns": ["/^apps/upstream/.*/config\\.yaml$/"],
      "matchStrings": [
        "repoURL:\\s*(?<registryUrl>https?://\\S+)\\s+name:\\s*(?<depName>\\S+)\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "{{{registryUrl}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Images dans les CR bruts",
      "managerFilePatterns": ["/^apps/.*/manifests/.*\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}