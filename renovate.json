{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "argocd": {
    "managerFilePatterns": ["/^appsets/.*\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version des charts OCI dans apps/upstream/*/config.yaml",
      "managerFilePatterns": ["/^apps/upstream/.*/config\\.yaml$/"],
      "matchStrings": [
        "repoURL:\\s*(?<registry>\\S+)\\s+name:\\s*(?<chart>\\S+)\\s+version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "{{{registry}}}/{{{chart}}}",
      "depNameTemplate": "{{{chart}}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Images dans les CR bruts (RenovateJob, etc.)",
      "managerFilePatterns": ["/^apps/.*/manifests/.*\\.ya?ml$/"],
      "matchStrings": [
        "image:\\s*(?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}